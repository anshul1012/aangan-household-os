# Copy to .env and fill in values. .env is gitignored — never commit real values.

# Discord
BOT_TOKEN=
# Comma-separated channel IDs this bot instance will react in (dev channel(s) here).
# Enable Developer Mode in Discord, then right-click a channel > Copy Channel ID.
ALLOWED_CHANNEL_IDS=
# Channel scheduled weekly/monthly summaries are posted to (push-only — the
# bot never needs to react to messages there, so this is separate from
# ALLOWED_CHANNEL_IDS above).
INSIGHTS_CHANNEL_ID=
# The household's #expenses channel — where the nightly unlogged-expense
# reminder is posted (push-only; not the inbound-logging whitelist above,
# though in V1 it's typically the same channel as one entry in it).
EXPENSES_CHANNEL_ID=

# Postgres (used by both the db container and the bot)
POSTGRES_USER=aangan
POSTGRES_PASSWORD=
POSTGRES_DB=aangan

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=
